# monero-wallet-rpc mit VIEW-ONLY-Wallet fuer den Malachi-Shop.
# Sieht eingehende Zahlungen, kann nichts ausgeben. Lauscht nur auf 127.0.0.1:18082
# (mit Digest-Login) und verbindet sich ueber Tor (127.0.0.1:9050) mit einem Remote-Node.

[Unit]
Description=Malachi Shop - monero-wallet-rpc (view-only)
After=network-online.target tor@default.service
Wants=network-online.target tor@default.service

[Service]
Type=simple
User=malachi-wallet
Group=malachi-wallet
WorkingDirectory=/var/lib/malachi-wallet
# Konfiguration (Remote-Node, Proxy, RPC-Login) und Wallet-Passwort kommen als
# Credentials (Dateien gehoeren root, 0600; %d = Credential-Verzeichnis im RAM).
LoadCredential=wallet-rpc.conf:/etc/malachi-wallet/wallet-rpc.conf
LoadCredential=wallet.pass:/etc/malachi-wallet/wallet.pass
ExecStart=/opt/monero/monero-wallet-rpc --config-file %d/wallet-rpc.conf --password-file %d/wallet.pass --wallet-file /var/lib/malachi-wallet/shop-view --shared-ringdb-dir /var/lib/malachi-wallet/ringdb --no-initial-sync --non-interactive
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

StateDirectory=malachi-wallet
StateDirectoryMode=0700
UMask=0077

# Netzwerk: nur Loopback (eigener RPC-Port, Tor-SOCKS)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

MemoryMax=768M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
