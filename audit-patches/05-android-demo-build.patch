+
+// Demo-Build (siehe defaultConfig): google-services.json kennt nur die echte
+// App-ID - ohne das bricht der Build mit "No matching client found" ab. FCM
+// wird im JS-Code aktuell nirgends genutzt (getFcmToken hat keinen Aufrufer,
+// pushSender.js fehlt auf dem Relay), der Demo fehlt dadurch also nichts.
+if (project.hasProperty('malachiDemo')) {
+    tasks.configureEach { task ->
+        if (task.name.contains('GoogleServices')) task.enabled = false
+    }
