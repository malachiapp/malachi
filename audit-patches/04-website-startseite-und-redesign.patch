+/* Malachi Web – Redesign 2026 (Audit/Website-Überarbeitung 2026-09-28)
+   Reine Darstellungsschicht ÜBER App.css: gleiche Klassennamen, keine
+   Logikänderung. Entfernen = die eine Import-Zeile in App.tsx löschen. */
+
+:root {
+  --bg: #030b17;
+  --surface: #0a1d36;
+  --surface-alt: #0e2744;
+  --border: rgba(120, 190, 255, 0.14);
+  --text: #eef6fc;
+  --text-sub: #a9c3d8;
+  --text-muted: #6f90aa;
+  --accent: #1cc0ee;
+  --accent-2: #8c7cff;
+  --green: #3ee6a8;
+  --danger: #ff6b6b;
+  --grad: linear-gradient(135deg, #7bf1ff 0%, #36e0ff 35%, #19a9ef 100%);
+}
+
+body {
+  background:
+    radial-gradient(900px 500px at 10% -10%, rgba(54, 224, 255, 0.10), transparent 60%),
+    radial-gradient(800px 500px at 110% 10%, rgba(140, 124, 255, 0.10), transparent 60%),
+    var(--bg);
+  background-attachment: fixed;
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+.app, .screen { background: transparent; }
+
+/* ── Buttons & Eingaben ─────────────────── */
+button {
+  background: var(--grad);
+  color: #00121f;
+  font-weight: 650;
+  border-radius: 14px;
+  box-shadow: 0 8px 24px -10px rgba(54, 224, 255, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.5);
+  transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
+}
+button:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.05); }
+button:active:not(:disabled) { transform: translateY(0); }
+button:disabled { background: var(--surface-alt); color: var(--text-muted); box-shadow: none; }
+button.danger { background: linear-gradient(135deg, #ff8a8a, #ff5c5c); color: #2a0000; }
+button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid #36e0ff; outline-offset: 2px; }
+
+input, textarea {
+  background: rgba(10, 29, 54, 0.8);
+  border: 1px solid var(--border);
+  border-radius: 14px;
+  transition: border-color .15s, box-shadow .15s;
+}
+input:focus, textarea:focus { border-color: rgba(54, 224, 255, 0.6); box-shadow: 0 0 0 4px rgba(54, 224, 255, 0.12); outline: none; }
+.dark input { background: rgba(10, 29, 54, 0.8); border-color: var(--border); }
+.screen.dark button { background: var(--grad); color: #00121f; }
+.screen.dark button:disabled { background: var(--surface-alt); color: var(--text-muted); }
+.screen.dark { background: transparent; }
+
+/* ── Einrichten / Entsperren ────────────── */
+.auth-screen { min-height: 100vh; }
+.auth-card {
+  width: min(420px, 100%);
+  display: flex; flex-direction: column; align-items: center; gap: 14px;
+  padding: 36px 28px 28px;
+  border-radius: 28px;
+  background: linear-gradient(180deg, rgba(20, 52, 92, 0.55), rgba(8, 24, 46, 0.65));
+  border: 1px solid var(--border);
+  box-shadow: 0 40px 100px -40px rgba(0, 170, 255, 0.45);
+  backdrop-filter: blur(10px);
+}
+.auth-card input, .auth-card button { max-width: none; width: 100%; }
+.auth-logo { border-radius: 20px; box-shadow: 0 16px 40px -12px rgba(54, 224, 255, 0.6); margin-bottom: 6px; }
+.auth-title { margin: 0; font-size: 24px; letter-spacing: -0.02em; }
+.auth-sub { margin: 0 0 6px; color: var(--text-sub); font-size: 14px; line-height: 1.5; }
+.auth-foot { margin: 8px 0 0; color: var(--text-muted); font-size: 12px; }
+.auth-card .error { margin: 0; }
+
+/* ── Startansicht / Split-View ──────────── */
+.shell { background: transparent; }
+.sidebar-pane { background: rgba(6, 18, 36, 0.72); }
+@media (min-width: 860px) {
+  .sidebar-pane { border-right: 1px solid var(--border); backdrop-filter: blur(8px); }
+}
+.header {
+  background: rgba(8, 22, 42, 0.8);
+  backdrop-filter: blur(12px);
+  border-bottom: 1px solid var(--border);
+  gap: 12px;
+}
+.header button { padding: 10px 14px; font-size: 14px; }
+.home-brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.home-brand img { border-radius: 11px; flex: none; }
+.home-brand h2 { font-size: 19px; letter-spacing: -0.01em; }
+.sub { color: var(--text-sub); }
+
+.contact-list { padding: 10px; gap: 6px; }
+.contact-row {
+  border: 1px solid transparent;
+  transition: background .15s, border-color .15s, transform .15s;
+}
+.contact-row:hover { background: rgba(14, 39, 68, 0.7); border-color: var(--border); }
+.contact-row.active, .contact-row.selected {
+  background: linear-gradient(90deg, rgba(54, 224, 255, 0.14), rgba(140, 124, 255, 0.08));
+  border-color: rgba(54, 224, 255, 0.35);
+}
+.contact-row-name { font-weight: 600; }
+.avatar {
+  background: linear-gradient(135deg, rgba(54, 224, 255, 0.25), rgba(140, 124, 255, 0.25));
+  color: #bff6ff;
+  border: 1px solid rgba(54, 224, 255, 0.3);
+}
+.row-menu, .safety-card {
+  background: #0b2140;
+  border: 1px solid var(--border);
+  box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6);
+}
+.row-menu button { background: transparent; box-shadow: none; color: var(--text); font-weight: 500; }
+.row-menu button:hover { background: var(--surface-alt); transform: none; }
+.row-menu-btn, .shield-icon-btn { background: transparent !important; box-shadow: none !important; color: var(--text-muted); }
+
+.empty-contacts {
+  margin: 24px 10px; padding: 22px; border-radius: 18px; text-align: center;
+  border: 1px dashed rgba(54, 224, 255, 0.3); background: rgba(10, 29, 54, 0.5);
+}
+.empty-contacts-title { margin: 0 0 6px; font-weight: 650; font-size: 16px; }
+.empty-contacts .muted { margin: 0; }
+
+.empty-main-pane { background: transparent; gap: 10px; }
+.empty-logo { border-radius: 30px; box-shadow: 0 30px 80px -30px rgba(54, 224, 255, 0.6); margin-bottom: 8px; }
+.empty-title { margin: 0; font-size: 26px; letter-spacing: -0.02em; }
+.empty-note {
+  margin-top: 10px; font-size: 12px; color: var(--text-muted);
+  padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border);
+}
+
+/* Zurueck/Schliessen links in der Kopfzeile: dezent statt Primaerknopf */
+.header > button:first-child {
+  background: transparent; color: var(--text-sub); box-shadow: none;
+  border: 1px solid var(--border); padding: 8px 12px;
+}
+.header > button:first-child:hover { color: var(--text); border-color: rgba(54, 224, 255, 0.4); }
+
+/* Inhaltsbereiche ohne .screen (z.B. Verbinden-Tabs) */
+.screen > .center {
