+// Tatsaechlicher Verbindungszustand fuer die Statusanzeigen (Demo
+// "liveStatus"/"contactDots"): Netz laut NetInfo, Erreichbarkeit des Relays
+// (letzte Anfragen erfolgreich?) und welche Kontakte gerade direkt per P2P
+// verbunden sind. Rein lesend, alle 2s aktualisiert.
+function useConnectivity(contacts, enabled) {
+  const [state, setState] = React.useState({ online: true, relayOk: true, connected: [] });
+  React.useEffect(() => {
+    if (!enabled) return undefined;
+    let online = true;
+    const tick = () => {
+      const connected = (contacts || []).filter(c => RTCStore.isConnected(c.id)).map(c => c.id);
+      const relayOk = getRelayHealth().consecutiveFailures < 3;
+      setState(prev => (prev.online === online && prev.relayOk === relayOk &&
+        prev.connected.join(',') === connected.join(',')) ? prev : { online, relayOk, connected });
+    };
+    const unsub = NetInfo.addEventListener(s => { online = !!s.isConnected && s.isInternetReachable !== false; tick(); });
+    tick();
+    const t = setInterval(tick, 2000);
+    return () => { clearInterval(t); unsub(); };
+  }, [contacts, enabled]);
+  return state;
+}
