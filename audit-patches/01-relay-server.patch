+
+describe('Speicher-Obergrenzen', () => {
+  let harness;
+  beforeAll(async () => { harness = await startRelayHarness({ env: { MAX_STORED_BYTES: String(200 * 1024) } }); });
+  afterAll(async () => { await harness.stop(); });
+
+  test('zu grosses Einzelpaket -> 413', async () => {
+    const res = await post(harness.baseUrl, '/packet', { payload: 'x'.repeat(70 * 1024), recipient: 'c_big' });
+    expect(res.status).toBe(413);
+  });
+
+  test('voller Speicher -> 507 statt Absturz, Relay bleibt erreichbar', async () => {
+    const statuses = [];
+    for (let i = 0; i < 6; i++) {
+      statuses.push((await post(harness.baseUrl, '/packet', { payload: 'y'.repeat(60 * 1024), recipient: `c_fill${i}` })).status);
+    }
+    expect(statuses.slice(0, 3)).toEqual([200, 200, 200]);
+    expect(statuses).toContain(507);
+    expect((await get(harness.baseUrl, '/status')).status).toBe(200);
+  });
+
+  test('abgeholte+bestaetigte Pakete geben den Platz wieder frei', async () => {
+    const pk = JSON.parse((await get(harness.baseUrl, '/packet/c_fill0')).body).packets;
+    expect(pk).toHaveLength(1);
+    await post(harness.baseUrl, '/packet/ack', { recipient: 'c_fill0', tokens: [pk[0].token] });
+    const res = await post(harness.baseUrl, '/packet', { payload: 'z'.repeat(60 * 1024), recipient: 'c_after' });
+    expect(res.status).toBe(200);
+  });
+
+  test('Transfer-Chunk mit ungueltigem Index -> 400', async () => {
+    const res = await post(harness.baseUrl, '/transfer/tok1/chunk/999999', { data: 'abc', total: 1 });
+    expect(res.status).toBe(400);
+  });
+});
