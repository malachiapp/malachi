+  afterAll(async () => { await harness.stop(); });
+
+  test('/packet/<id> liefert keine Pakete fuer "<id>_answer" mehr', async () => {
+    await post(harness.baseUrl, '/packet', { payload: 'FUER_ANSWER', recipient: 'c_ddd_answer' });
+    const wrong = JSON.parse((await get(harness.baseUrl, '/packet/c_ddd')).body);
+    expect(wrong.packets).toHaveLength(0);
+    const right = JSON.parse((await get(harness.baseUrl, '/packet/c_ddd_answer')).body);
+    expect(right.packets.map((p) => p.payload)).toEqual(['FUER_ANSWER']);
+  });
+
+  test('/receive/ liefert/loescht keine Reconnect-Angebote', async () => {
+    await post(harness.baseUrl, '/reconnect/offer', { offer: 'ENC_OFFER_E', contactId: 'c_eee_offer' });
+    const recv = JSON.parse((await get(harness.baseUrl, '/receive/c_eee_offer')).body);
+    expect(recv.packets).toHaveLength(0);
+    await sleep(1100); // /receive loeschte frueher nach 1s
+    const offer = await get(harness.baseUrl, '/reconnect/offer/c_eee_offer');
