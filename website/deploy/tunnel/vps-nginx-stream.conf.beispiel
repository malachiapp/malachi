# BEISPIEL - Variante B (Tunnel): reine TCP-Weiterleitung auf dem VPS.
#   sudo apt-get install nginx libnginx-mod-stream
#   Diese Datei nach /etc/nginx/stream.d/malachi.conf und in /etc/nginx/nginx.conf
#   GANZ OBEN (ausserhalb von http { }) einfuegen:   include /etc/nginx/stream.d/*.conf;
#   Debians Beispielseite abschalten (rm /etc/nginx/sites-enabled/default), dann nginx -t && systemctl reload nginx
#
# Der VPS entschluesselt NICHTS: Er reicht TCP 443/80 an den Laptop durch und
# stellt jeder Verbindung eine PROXY-Zeile mit der Besucher-IP voran, damit die
# Ratenbegrenzung auf dem Laptop je Besucher greift. Kein Zugriffsprotokoll.

stream {
    access_log off;

    server {
        listen 443;
        listen [::]:443;
        proxy_pass 10.66.0.2:8443;
        proxy_protocol on;
        proxy_connect_timeout 5s;
        proxy_timeout 10m;
    }

    server {
        listen 80;
        listen [::]:80;
        proxy_pass 10.66.0.2:8080;
        proxy_protocol on;
        proxy_connect_timeout 5s;
        proxy_timeout 1m;
    }
}
