<?xml version="1.0" encoding="utf-8"?>
<!-- Nur Website-Variante (Flavor "web"), wird mit src/main/AndroidManifest.xml
     zusammengefuehrt.

     Platz fuer alles, was es NUR ausserhalb von Google Play geben darf -
     insbesondere spaeter fuer den In-App-Updater (website/UPDATE_FORMAT.md):
         <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
     gehoert ausschliesslich HIERHER, nie nach src/main: Google Play verbietet
     Apps, sich ausserhalb von Google Play selbst zu aktualisieren (Richtlinie
     "Missbrauch von Geraeten und Netzwerken"), und REQUEST_INSTALL_PACKAGES
     ist dort deklarationspflichtig. Der Updater-Code selbst muss zusaetzlich
     mit Distribution.isWeb() abgesichert sein. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- In-App-Updater (update/MalachiUpdaterModule.kt): die geladene, signaturgepruefte
         APK geht an den System-Installer, der Nutzer bestaetigt jede Installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
