<?xml version="1.0" encoding="utf-8"?>
<!-- Nur Google-Play-Variante (Flavor "play"), wird mit src/main/AndroidManifest.xml
     zusammengefuehrt. Begruendungen und Play-Console-Deklarationen: PLAY_STORE.md,
     Abschnitt "Berechtigungen".

     Die Berechtigung com.android.vending.BILLING kommt automatisch aus der
     Billing Library (nur in dieser Variante eingebunden). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google-Play-Richtlinie "Fotos und Videos" (READ_MEDIA_IMAGES/_VIDEO):
         nur fuer Apps, deren Kernfunktion breiten Galeriezugriff braucht -
         Messenger muessen die Fotoauswahl des Systems nutzen. Malachi tut das
         bereits (react-native-image-picker -> Photo Picker; Speichern in die
         Galerie per MediaStore braucht keine Leseberechtigung) und fragt
         READ_MEDIA_IMAGES nirgends zur Laufzeit an. Hier entfernt, damit keine
         Deklaration in der Play Console noetig ist und nichts abgelehnt wird. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />

    <!-- Keine Werbe-ID: in der Play Console wird "Werbe-ID: Nein" erklaert.
         Keine Bibliothek der App braucht sie; falls eine Google-Bibliothek sie
         je ueber ihr Manifest einschleppt, wird sie hier entfernt (sonst
         warnt die Play Console bei jedem Upload). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

</manifest>
