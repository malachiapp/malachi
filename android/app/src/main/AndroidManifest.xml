              <action android:name="android.intent.action.MAIN" />
              <category android:name="android.intent.category.LAUNCHER" />
          </intent-filter>
      </activity-alias>
      <!-- Platin -->
      <activity-alias
          android:name="com.securecommapp.AppIcon_platin"
          android:targetActivity="com.securecommapp.MainActivity"
          android:enabled="false"
          android:exported="true"
          android:label="${appLabel}"
          android:icon="@mipmap/ic_appicon_platin"
          android:roundIcon="@mipmap/ic_appicon_platin">
          <intent-filter>
              <action android:name="android.intent.action.MAIN" />
              <category android:name="android.intent.category.LAUNCHER" />
          </intent-filter>
      </activity-alias>
      <!-- APP-ICON-ALIASES:END -->

      <service
          android:name=".MalachiService"
          android:enabled="true"
          android:exported="false"
          android:foregroundServiceType="remoteMessaging" />

      <!-- FOREGROUND_SERVICE_PLAN.md Stufe 2: HeadlessJS-Task
           "MalachiBackgroundSync" (index.js/BackgroundSync.js), periodisch
           von MalachiService per AlarmManager (MalachiSyncAlarmReceiver)
           gestartet, nur wenn die App nicht im Vordergrund ist. Nicht
           exportiert - nur die App selbst startet ihn. -->
      <!-- tor im eigenen Prozess: nach einem Netzwechsel frisch startbar
           (siehe MalachiTorProcessService.kt). Nicht exportiert. -->
      <service
          android:name="com.securecommapp.tor.MalachiTorProcessService"
          android:process=":tor"
          android:exported="false" />

      <service
          android:name=".MalachiHeadlessTaskService"
          android:enabled="true"
          android:exported="false" />

      <receiver
          android:name=".MalachiSyncAlarmReceiver"
          android:exported="false" />

      <!-- Startet MalachiService nach Neustart/App-Update wieder, nur falls er
           vorher (nach abgeschlossenem Setup) laufen sollte - siehe
           BootReceiver.kt. exported="false" genuegt: beide Broadcasts kommen
           vom System selbst. -->
      <receiver
          android:name=".BootReceiver"
          android:exported="false">
          <intent-filter>
              <action android:name="android.intent.action.BOOT_COMPLETED" />
              <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          </intent-filter>
      </receiver>

      <service
          android:name="com.securecommapp.calling.MalachiConnectionService"
          android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
          android:exported="true">
          <intent-filter>
              <action android:name="android.telecom.ConnectionService" />
          </intent-filter>
      </service>

      <receiver
          android:name="com.securecommapp.calling.CallActionReceiver"
          android:exported="false" />

      <!-- Nutzerwunsch: empfangene Dateien oeffnen/teilen koennen
           (FileShareModule.kt). Ein rohes file://-URI aus dem eigenen
           Cache-Verzeichnis ueber einen Intent an eine andere App weiterreichen
           wirft ab Android 7 (API 24) eine FileUriExposedException - FileProvider
           wandelt es stattdessen in ein befristet freigegebenes content://-URI um. -->
      <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
              android:name="android.support.FILE_PROVIDER_PATHS"
              android:resource="@xml/file_paths" />
      </provider>

      <!-- Kein Nutzungs-Telemetrie-Versand von Google ML Kit (PLAY_STORE.md,
           Datensicherheit). Der QR-Scanner react-native-camera-kit bringt
           ML Kit mit (com.google.mlkit:barcode-scanning); ML Kit meldet laut
           Google Nutzungs-/Leistungsdaten ueber "datatransport" an Google
           (Backend "cct" = firebaselogging). Ohne den hier entfernten
           Backend-Eintrag findet der Uploader kein Ziel und verwirft die
           Ereignisse ("Unknown backend ... deleting event batch",
           transport-runtime Uploader) - der Scanner selbst arbeitet
           unveraendert offline (Modell ist in der APK enthalten).
           Nach dem Build pruefen: im gemergten Manifest
           (app/build/intermediates/merged_manifests/...) darf
           "backend:com.google.android.datatransport.cct.CctBackendFactory"
           nicht mehr vorkommen. Gilt fuer beide Varianten. -->
      <service
          android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
          android:exported="false">
          <meta-data
              android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
              tools:node="remove" />
      </service>

    </application>
</manifest>
