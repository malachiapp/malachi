<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Standort-Versand (ohne Google): @react-native-community/geolocation
         nutzt auf Android das plattformeigene LocationManager-API, keine
         Google Play Services FusedLocationProviderClient. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- War "dataSync" - Live-Test 2026-09-27 zeigte, dass sich die
         Dienst-Benachrichtigung per Wisch-Geste entfernen liess und dabei den
         gesamten Dienst (samt P2P-Empfang) beendete, ohne Warnung. Android 14+
         behandelt "dataSync"/"mediaProcessing" bewusst als kurzlebige,
         nutzer-wegwischbare Typen mit 6h-Laufzeitlimit (Anti-Missbrauchs-
         Massnahme, da diese beiden Typen am haeufigsten fuer unbegrenzte
         Hintergrundarbeit zweckentfremdet wurden). "remoteMessaging" ist der
         fuer diesen Zweck (durchgehender Nachrichtenempfang) tatsaechlich
         vorgesehene Typ und unterliegt diesem Zeitlimit/der Wegwisch-Regel
         nicht - muss nach dem naechsten Release-Build auf dem echten Geraet
         verifiziert werden (Wegwischen erneut versuchen), da Android das
         Wegwisch-Verhalten pro Typ nicht dokumentiert öffentlich zusichert. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Stufe 2: HeadlessJsTaskService und MalachiService.onSyncAlarm()
         halten kurz einen PARTIAL_WAKE_LOCK, damit die CPU waehrend eines
         Hintergrund-Syncs nicht einschlaeft. Normale Berechtigung (ohne
         Nutzerdialog); kam bisher nur indirekt ueber Bibliotheks-Manifeste. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Audit 2026-10-19 (A7): nie angefragt (Bildauswahl ueber den System-Picker,
         Speichern in die Galerie ueber MediaStore) - auch aus Bibliotheken entfernen. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Produktionsreife-Review (Play-Policy-Teil): FOREGROUND_SERVICE_MICROPHONE
         und FOREGROUND_SERVICE_PHONE_CALL wurden hier deklariert, aber im
         gesamten nativen Code nie tatsaechlich verwendet - der einzige Aufruf
         von startForeground() (MalachiService.kt) laeuft ausschliesslich unter
         dem bereits korrekt deklarierten "dataSync"-Typ, und der self-managed
         ConnectionService fuer Anrufe (MalachiConnectionService.kt) startet gar
         keinen eigenen Foreground-Service (das Telecom-Framework uebernimmt die
         Anruf-UI). Play markiert ungenutzte "special use"-Foreground-Service-
         Berechtigungen im Review als Befund und verlangt sonst eine
         Rechtfertigung in der Play-Console-Deklaration, die es hier mangels
         echter Verwendung nicht geben kann - entfernt statt unbegruendet
         deklariert zu lassen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- REQUEST_INSTALL_PACKAGES (In-App-Updater) steht NUR im Manifest des
         Web-Flavors (src/web/AndroidManifest.xml) - Google Play verbietet
         Selbst-Updates. -->

    <application
      android:name=".MainApplication"
      android:label="${appLabel}"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:supportsRtl="true"
      android:usesCleartextTraffic="false"
      android:theme="@style/AppTheme">

      <!-- Audit 2026-10-19 (A7): Bildschirmfreigabe von react-native-webrtc wird nicht
           genutzt - Dienst (Foreground-Typ mediaProjection) nicht mit ausliefern. -->
      <service android:name="com.oney.WebRTCModule.MediaProjectionService" tools:node="remove" />

      <activity
        android:name=".MainActivity"
        android:label="${appLabel}"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:taskAffinity=""
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- Der Launcher-Eintrag (MAIN/LAUNCHER) liegt seit "App-Icon passend
             zum Design" auf den activity-alias-Eintraegen unten (je Icon einer,
             genau einer aktiv). MainActivity selbst bleibt immer aktiviert und
             exportiert: Deep Links (malachi://connect) und alle PendingIntents
             (Benachrichtigungen, Anruf-Vollbild, CallBridge) zielen direkt auf
             diese Klasse und funktionieren mit jedem Icon. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="malachi" android:host="connect" />
        </intent-filter>
      </activity>

