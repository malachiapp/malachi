*.jks
# Google-Play-Kontoschluessel und Antraege (falls je lokal abgelegt)
play-service-account*.json
*.pepk

# Secrets - nie committen (siehe secrets.local.js.example fuer die Vorlage)
secrets.local.js
firebase-service-account.json

# Lokale APK-Sicherungen und generierte Release-Bundles - keine Build-Artefakte im Git
apk-backups/
android/app/src/main/assets/

# Kotlin-Build-Cache
android/.kotlin/

# Beta-APKs fuer Freunde/Familie (nur lokal, nie einchecken)
Malachi-Beta/

# Marketing-Material (Social Media, Screenshots) - nur lokal
Malachi-Marketing/

# Betriebshandbuch mit persoenlichen Pfaden (wird herauskopiert, nicht versioniert)
Malachi-Betriebshandbuch/

# Oeffentlicher Export (eigenes Git-Repo, wird separat veroeffentlicht)
Malachi-Open-Source/
